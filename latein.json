  {
   "id": "bg",
   "tab": "Caesar",
   "author": "C. Iulius Caesar",
   "title": "De bello Gallico",
   "ref": "Liber I, 1 · Abschnitt 1 (Sätze 1–4)",
   "part": 1,
   "verse": false,
   "sentences": [
    {
     "la": "Gallia est omnis divisa in partes tres, quarum unam incolunt Belgae, aliam Aquitani, tertiam qui ipsorum lingua Celtae, nostra Galli appellantur.",
     "de": "Gallien als Ganzes ist in drei Teile geteilt: Den einen bewohnen die Belger, den zweiten die Aquitaner, den dritten diejenigen, die in ihrer eigenen Sprache Kelten, in unserer Gallier heissen."
    },
    {
     "la": "Hi omnes lingua, institutis, legibus inter se differunt.",
     "de": "Sie alle unterscheiden sich voneinander in Sprache, Einrichtungen und Gesetzen."
    },
    {
     "la": "Gallos ab Aquitanis Garumna flumen, a Belgis Matrona et Sequana dividit.",
     "de": "Von den Aquitanern trennt die Gallier der Fluss Garonne, von den Belgern trennen sie Marne und Seine."
    },
    {
     "la": "Horum omnium fortissimi sunt Belgae, propterea quod a cultu atque humanitate provinciae longissime absunt, minimeque ad eos mercatores saepe commeant atque ea quae ad effeminandos animos pertinent important, proximique sunt Germanis, qui trans Rhenum incolunt, quibuscum continenter bellum gerunt.",
     "de": "Von allen diesen sind die Belger die tapfersten, weil sie von der Lebensart und Bildung der Provinz am weitesten entfernt sind, weil Kaufleute nur sehr selten zu ihnen kommen und das einführen, was die Gemüter verweichlicht, und weil sie den Germanen am nächsten wohnen, die jenseits des Rheins leben und mit denen sie ununterbrochen Krieg führen."
    }
   ],
   "source": {
    "url": "https://dcc.dickinson.edu/caesar/book-1/chapter-1-1",
    "title": "Dickinson College Commentaries"
   }
  },
  {
   "id": "cons",
   "tab": "Boethius",
   "author": "Anicius Manlius Severinus Boethius",
   "title": "De consolatione philosophiae",
   "ref": "Liber I, Metrum 1 · Verse 1–12",
   "part": 1,
   "verse": true,
   "sentences": [
    {
     "la": "Carmina qui quondam studio florente peregi,\nflebilis, heu, maestos cogor inire modos.",
     "de": "Der ich einst in blühendem Eifer Lieder vollendet habe, muss nun – ach! – unter Tränen traurige Weisen anstimmen."
    },
    {
     "la": "Ecce mihi lacerae dictant scribenda Camenae\net veris elegi fletibus ora rigant.",
     "de": "Sieh, die zerzausten Musen sagen mir vor, was ich schreiben soll, und elegische Verse benetzen mein Gesicht mit echten Tränen."
    },
    {
     "la": "Has saltem nullus potuit pervincere terror,\nne nostrum comites prosequerentur iter.",
     "de": "Wenigstens sie konnte kein Schrecken davon abbringen, mich als Gefährtinnen auf meinem Weg zu begleiten."
    },
    {
     "la": "Gloria felicis olim viridisque iuventae\nsolantur maesti nunc mea fata senis.",
     "de": "Einst der Ruhm meiner glücklichen, blühenden Jugend, trösten sie nun mein Los als trauriger alter Mann."
    },
    {
     "la": "Venit enim properata malis inopina senectus\net dolor aetatem iussit inesse suam.",
     "de": "Denn unerwartet ist das Alter gekommen, vom Unglück beschleunigt, und der Schmerz hat mir sein eigenes Alter auferlegt."
    },
    {
     "la": "Intempestivi funduntur vertice cani\net tremit effeto corpore laxa cutis.",
     "de": "Zur Unzeit fallen mir graue Haare vom Scheitel, und schlaff zittert die Haut am erschöpften Körper."
    }
   ],
